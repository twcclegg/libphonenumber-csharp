<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear discards any source a machine-level or user-level nuget.config would otherwise add,
         so a restore here resolves from nuget.org and nowhere else regardless of how the machine is
         configured. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- With a single source this changes nothing today. It matters the moment a second source is
       added: without a mapping, any source can serve any package id, so a private feed becomes a
       route for substituting a public package. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
