<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>C# port of Google's common Java, C++ and Javascript library for parsing, formatting, storing and validating international phone numbers. https://github.com/google/libphonenumber</Description>
    <Title>libphonenumber-csharp</Title>
    <AssemblyName>PhoneNumbers</AssemblyName>
    <PackageId>libphonenumber-csharp</PackageId>
    <!-- Placeholder only. The real version comes from the release tag: publish_nuget.yml -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <Authors>Patrick Mézard;Thomas Clegg;Jarrod Alexander;Google;libphonenumber contributors</Authors>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <PackageTags>phonenumber phone libphonenumber e164 e.164 international</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Every pack is compared against the latest release, the surface consumers upgrade from.
         Restore downloads that package, so the version must be one already on nuget.org. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>9.0.37</PackageValidationBaselineVersion>
    <!-- Rules enforced on top of the default set are listed in .editorconfig, with the reasoning. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1062</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <Nullable>enable</Nullable>
    <!--
      Opt in to trim/AOT analysis on modern .NET TFMs. IsAotCompatible turns on the trim, single-file,
      and AOT analyzers, and stamps the assembly with the metadata that lets consumers PublishAot
      without warnings about untrimmable references. netstandard2.0 consumers are unaffected.
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!--
      XML metadata, geocoding text trees, and the timezones map_data.txt are all no longer
      embedded directly: the build pipeline generates equivalent binary files (see the
      BuildBinaryMetadata, BuildGeocodingBins, and BuildTimezoneBin targets below) and embeds
      those under the "PhoneNumbers.metadata.*", "PhoneNumbers.geocoding.*", and
      "PhoneNumbers.timezones.*" namespaces respectively. The text/xml originals still live in
      resources/ on disk so the build tool and the test project can use them as input.
    -->
    <EmbeddedResource Include="ILLink.Substitutions.xml" LogicalName="ILLink.Substitutions.xml" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="" />
    <None Include="buildTransitive\libphonenumber-csharp.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Build-only ProjectReference: forces MetadataBuilder to be built before this project (so the
    Target below can invoke it), but does not pull MetadataBuilder.dll into PhoneNumbers' compile
    references or output. MetadataBuilder source-links the few files it needs from this project,
    so there's no circular dependency.
  -->
  <ItemGroup>
    <ProjectReference Include="..\PhoneNumbers.MetadataBuilder\PhoneNumbers.MetadataBuilder.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType=""
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Bin output is platform/TFM-agnostic; share across all TFMs (BaseIntermediateOutputPath
      = obj\, not obj\<TFM>\). Paths intentionally do NOT end with a separator — Windows
      shell-quoting collapses `\"` (a backslash immediately before a closing double-quote) into
      an embedded literal `"`, which corrupts the path inside the Exec command. Trailing `/` is
      added explicitly only on the embedding glob.
    -->
    <BinaryMetadataDir>$(BaseIntermediateOutputPath)metadata</BinaryMetadataDir>
    <BinaryGeocodingDir>$(BaseIntermediateOutputPath)geocoding</BinaryGeocodingDir>
    <BinaryTimezonesDir>$(BaseIntermediateOutputPath)timezones</BinaryTimezonesDir>
    <BinaryCarrierDir>$(BaseIntermediateOutputPath)carrier</BinaryCarrierDir>
    <BinaryLocaleDir>$(BaseIntermediateOutputPath)locale</BinaryLocaleDir>
    <ResourcesDir>$(MSBuildThisFileDirectory)..\..\resources/</ResourcesDir>
    <MetadataBuilderProject>$(MSBuildThisFileDirectory)..\PhoneNumbers.MetadataBuilder\PhoneNumbers.MetadataBuilder.csproj</MetadataBuilderProject>
    <MetadataBuilderDll>$(MSBuildThisFileDirectory)..\PhoneNumbers.MetadataBuilder\bin\$(Configuration)\net10.0\PhoneNumbers.MetadataBuilder.dll</MetadataBuilderDll>
  </PropertyGroup>

  <!--
    BuildMetadataBuilder runs the MetadataBuilder project's Build target via the in-process
    <MSBuild> task. Two reasons we do NOT shell out to `dotnet run` instead:
      1. `dotnet run` builds-then-runs in a separate process, and MSBuild cannot coordinate two
         concurrent invocations. When `dotnet build PhoneNumbers.slnx` builds PhoneNumbers and
         PhoneNumbers.Test in parallel, both projects' outer cross-targeting builds would each
         spawn that command targeting MetadataBuilder, racing on MetadataBuilder's own obj
         folder (CS2012 on refint/PhoneNumbers.MetadataBuilder.dll).
      2. The MSBuild task is serialized by MSBuild's BuildManager — a second caller hits the
         cache and gets the existing build result instead of rebuilding from scratch.
    The dll is then run directly via `dotnet path/to/dll`, which never touches obj.
  -->
  <!--
    MetadataBuilder is built via the ProjectReference above. We deliberately do NOT also call
    `<MSBuild>` on it here: doing both creates two parallel build invocations of the same project
    in the cross-targeting outer flow, which races on apphost generation. The ProjectReference
    schedules MetadataBuilder before the inner per-TFM builds resolve their refs, which is when
    our Generate* targets fire (BeforeTargets="AssignTargetPaths").
  -->

  <!--
    One target, one tool invocation, for every generated data file.

    This used to be five Generate* targets driving seven `dotnet MetadataBuilder` processes. Each
    paid a process launch and a turn through the tool's cross-process mutex, and each needed its
    own Inputs/Outputs gate whose Outputs named a *sentinel* file (obj/geocoding/en.1) standing in
    for a directory of ~220 outputs — so a gate could report up-to-date while siblings were stale.
    The tool's `all` subcommand does the whole job in one process, and the three multi-file data
    sets are now packed into single .pack files, so Outputs below names every real output.

    Timing is unchanged and still load-bearing: generation runs once on the outer cross-targeting
    build (DispatchToInnerBuilds) and once on a direct single-TFM build (AssignTargetPaths). The
    Inputs/Outputs gate means the per-TFM inner builds re-evaluate, see the outputs are newer, and
    skip — which is what keeps three concurrent inner builds off the same obj directory. The tool
    also re-checks freshness per data set inside its mutex, so a redundant call is a no-op rather
    than a rewrite.
  -->
  <ItemGroup>
    <!--
      Top-level so the globs resolve at parse time and the Inputs attribute below sees the full
      list. Collected inside the target body they would be empty when the gate is evaluated, and
      the target would always report up-to-date.
    -->
    <_MetadataSourceFile Include="$(ResourcesDir)PhoneNumberMetadata.xml" />
    <_MetadataSourceFile Include="$(ResourcesDir)ShortNumberMetadata.xml" />
    <_MetadataSourceFile Include="$(ResourcesDir)PhoneNumberAlternateFormats.xml" />
    <_MetadataSourceFile Include="$(ResourcesDir)geocoding/**/*.txt" />
    <_MetadataSourceFile Include="$(ResourcesDir)carrier/**/*.txt" />
    <_MetadataSourceFile Include="$(ResourcesDir)locale/country_names.txt" />
    <_MetadataSourceFile Include="$(ResourcesDir)timezones/map_data.txt" />
  </ItemGroup>

  <Target Name="GenerateBinaryMetadata"
          BeforeTargets="AssignTargetPaths"
          Inputs="@(_MetadataSourceFile)"
          Outputs="$(BinaryMetadataDir)/PhoneNumberMetadata_US;$(BinaryMetadataDir)/ShortNumberMetadata_US;$(BinaryMetadataDir)/PhoneNumberAlternateFormats_49;$(BinaryGeocodingDir)/geocoding.pack;$(BinaryCarrierDir)/carrier.pack;$(BinaryLocaleDir)/locale.pack;$(BinaryTimezonesDir)/map_data.bin">
    <Exec Command="dotnet &quot;$(MetadataBuilderDll)&quot; all &quot;$(ResourcesDir).&quot; &quot;$(BaseIntermediateOutputPath).&quot;" />
  </Target>

  <!--
    Embedding runs on every inner per-TFM build (AssignTargetPaths only — there's no resource
    embedding on the cross-targeting outer). The per-region metadata is still a glob, because the
    set of regions changes with every upstream sync; the four data-set resources are named
    explicitly, because those exact names are what ILLink.Substitutions.xml removes and a glob
    would let a rename silently stop matching.
  -->
  <Target Name="EmbedBinaryMetadata"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="GenerateBinaryMetadata">
    <!--
      Two-step add to avoid an MSBuild item-batching surprise: a single
      `<EmbeddedResource Include="path/*" LogicalName="...%(Filename)..." />` inside a Target's
      ItemGroup makes MSBuild batch the metadata expansion across every existing EmbeddedResource
      item as well as the new ones from the glob, producing a cross-product of bogus items each
      carrying an unrelated item's LogicalName. Globbing into a private item first, then
      `Include="@(_X)"` with metadata, evaluates %(Filename) per-item against the named collection
      only.
    -->
    <ItemGroup>
      <_BinMetadataFile Include="$(BinaryMetadataDir)/*" />
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Include="@(_BinMetadataFile)"
                        LogicalName="PhoneNumbers.metadata.%(_BinMetadataFile.Filename)%(_BinMetadataFile.Extension)" />
      <EmbeddedResource Include="$(BinaryGeocodingDir)/geocoding.pack"
                        LogicalName="PhoneNumbers.geocoding.pack" />
      <EmbeddedResource Include="$(BinaryCarrierDir)/carrier.pack"
                        LogicalName="PhoneNumbers.carrier.pack" />
      <EmbeddedResource Include="$(BinaryLocaleDir)/locale.pack"
                        LogicalName="PhoneNumbers.locale.pack" />
      <EmbeddedResource Include="$(BinaryTimezonesDir)/map_data.bin"
                        LogicalName="PhoneNumbers.timezones.map_data.bin" />
    </ItemGroup>
  </Target>

  <!--
    Make the generated files visible to clean. Runs only on the outer cross-targeting build (where
    TargetFramework is empty) or on a genuine single-TFM project: the bins are shared across TFMs,
    so letting all three inner cleans fire would race three RemoveDir calls on one directory and
    fail with MSB3231 when one enumerates a file another has already deleted.
  -->
  <Target Name="CleanBinaryMetadata" AfterTargets="Clean"
          Condition="'$(TargetFramework)' == '' Or '$(TargetFrameworks)' == ''">
    <RemoveDir Directories="$(BinaryMetadataDir)" Condition="Exists('$(BinaryMetadataDir)')" />
    <RemoveDir Directories="$(BinaryGeocodingDir)" Condition="Exists('$(BinaryGeocodingDir)')" />
    <RemoveDir Directories="$(BinaryTimezonesDir)" Condition="Exists('$(BinaryTimezonesDir)')" />
    <RemoveDir Directories="$(BinaryCarrierDir)" Condition="Exists('$(BinaryCarrierDir)')" />
    <RemoveDir Directories="$(BinaryLocaleDir)" Condition="Exists('$(BinaryLocaleDir)')" />
  </Target>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="System.Collections.Immutable" />
    <!-- FlyweightMapStorage's ByteBuffer uses System.Buffers.Binary.BinaryPrimitives and
         byte[].AsSpan(), neither of which netstandard2.0 has without this package. -->
    <PackageReference Include="System.Memory" />
  </ItemGroup>

</Project>
