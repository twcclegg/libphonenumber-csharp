<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>C#-idiomatic companion to libphonenumber-csharp: non-throwing PhoneNumber.TryParse, formatting and validation helpers on PhoneNumber, a System.Text.Json converter (Native AOT friendly) and a DataAnnotations validation attribute. Helpers with no counterpart in Google's Java libphonenumber live here so the core package can keep mirroring it.</Description>
        <Title>libphonenumber-csharp.extensions</Title>
        <AssemblyName>PhoneNumbers.Extensions</AssemblyName>
        <PackageId>libphonenumber-csharp.extensions</PackageId>
        <!-- Placeholder only. The real version comes from the release tag: publish_nuget.yml -->
        <VersionPrefix>0.0.0</VersionPrefix>
        <Authors>Thomas Clegg</Authors>
        <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
        <PackageTags>phonenumber phone libphonenumber e164 e.164 international extensions tryparse validation dataannotations json aspnetcore</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Baselined on the same release as PhoneNumbers.csproj; see the note there. -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>9.0.37</PackageValidationBaselineVersion>
        <!-- Pinned, not "latest": the extension(PhoneNumber) block in PhoneNumberParser needs C# 14,
             and an SDK bump must not change the semantics of what has shipped. -->
        <LangVersion>14</LangVersion>
        <!-- On every target, netstandard2.0 included: the attributes the annotations need are
             polyfilled internally there (see Polyfills/). -->
        <Nullable>enable</Nullable>
        <!-- CS0436: the netstandard2.0 polyfill of System.ObsoleteAttribute (Polyfills/) deliberately
             shadows the one in netstandard.dll, which has no DiagnosticId or UrlFormat. -->
        <NoWarn>$(NoWarn);CA1014;CA1031;CA1062;CS0436</NoWarn>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <AnalysisLevel>latest</AnalysisLevel>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\icon.png" Pack="true" PackagePath="" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PhoneNumbers\PhoneNumbers.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- PhoneNumberParser.IsViableCandidate is tested directly against Parse. -->
      <InternalsVisibleTo Include="PhoneNumbers.Extensions.Test" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
      <PackageReference Include="System.Text.Json" />
      <PackageReference Include="System.ComponentModel.Annotations" />
    </ItemGroup>

    <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
      <!-- Mirrors PhoneNumbers.csproj: opt in to trim/AOT analysis on modern .NET TFMs now that
           PhoneNumberJsonContext exists specifically to support Native AOT consumers. -->
      <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

</Project>
