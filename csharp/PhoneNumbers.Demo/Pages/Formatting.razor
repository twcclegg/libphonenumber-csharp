@page "/format"
@inherits PhoneNumberPageBase

<PageTitle>Formatting - libphonenumber-csharp</PageTitle>

<div class="reveal">
<div class="page-header">
    <div class="page-header__eyebrow">PhoneNumberUtil.Format</div>
    <h1 class="page-header__title">Formatting</h1>
    <p class="page-header__description">See how a phone number looks in every supported format, including out-of-country and mobile dialing formats.</p>
</div>

<div class="card">
    <div class="card__header">
        <div class="card__title">Input</div>
    </div>

    <div class="form__row--three-col">
        <div class="form__group form__group--flush">
            <label class="form__label" for="format-phone">Phone Number</label>
            <input id="format-phone"
                   class="form__input form__input--phone"
                   type="text"
                   value="@PhoneInput"
                   @oninput="OnPhoneInput"
                   @onchange="OnPhoneCommit"
                   placeholder="+1 650 253 0000"
                   autocomplete="tel" />
        </div>
        <div class="form__group form__group--flush">
            <label class="form__label" for="format-region">Default Region</label>
            <RegionSelect id="format-region" Value="@SelectedRegion" ValueChanged="OnRegionChange" />
        </div>
        <div class="form__group form__group--flush">
            <label class="form__label" for="format-calling-from">Calling From</label>
            <RegionSelect id="format-calling-from" Value="@_callingFrom" ValueChanged="OnCallingFromChange" />
        </div>
    </div>
</div>

@if (ParseError != null)
{
    <div class="error-message" role="alert">@ParseError</div>
}
else if (Parsed != null)
{
    <div aria-live="polite">
        <div class="card">
            <div class="card__header">
                <div class="card__title">Standard Formats</div>
            </div>

            <div class="format-list">
                <div class="format-list__item">
                    <div class="format-list__name">E.164</div>
                    <div class="format-list__value">@PhoneUtil.Format(Parsed, PhoneNumberFormat.E164)</div>
                </div>
                <div class="format-list__item">
                    <div class="format-list__name">International</div>
                    <div class="format-list__value">@PhoneUtil.Format(Parsed, PhoneNumberFormat.INTERNATIONAL)</div>
                </div>
                <div class="format-list__item">
                    <div class="format-list__name">National</div>
                    <div class="format-list__value">@PhoneUtil.Format(Parsed, PhoneNumberFormat.NATIONAL)</div>
                </div>
                <div class="format-list__item">
                    <div class="format-list__name">RFC 3966</div>
                    <div class="format-list__value">@PhoneUtil.Format(Parsed, PhoneNumberFormat.RFC3966)</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card__header">
                <div class="card__title">Contextual Formats</div>
                <div class="card__subtitle">Formatted for dialing from @_callingFrom</div>
            </div>

            <div class="format-list">
                <div class="format-list__item">
                    <div class="format-list__name">Out-of-Country</div>
                    <div class="format-list__value">@PhoneUtil.FormatOutOfCountryCallingNumber(Parsed, _callingFrom)</div>
                </div>
                <div class="format-list__item">
                    <div class="format-list__name">Mobile Dialing</div>
                    <div class="format-list__value">@PhoneUtil.FormatNumberForMobileDialing(Parsed, _callingFrom, true)</div>
                </div>
                <div class="format-list__item">
                    <div class="format-list__name">Mobile (No Format)</div>
                    <div class="format-list__value">@PhoneUtil.FormatNumberForMobileDialing(Parsed, _callingFrom, false)</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card__header">
                <div class="card__title">Other Properties</div>
            </div>

            <div class="format-list">
                <div class="format-list__item">
                    <div class="format-list__name">National Significant</div>
                    <div class="format-list__value">@PhoneUtil.GetNationalSignificantNumber(Parsed)</div>
                </div>
                <div class="format-list__item">
                    <div class="format-list__name">Can Dial Intl.</div>
                    <div class="format-list__value">@(PhoneUtil.CanBeInternationallyDialled(Parsed) ? "Yes" : "No")</div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-state__icon" aria-hidden="true">
                <ListIcon />
            </div>
            <p class="empty-state__message">Enter a phone number above to see all format options</p>
        </div>
    </div>
}
</div>

@code {
    private const string DefaultCallingFrom = "GB";
    private string _callingFrom = DefaultCallingFrom;

    protected override string DefaultNumber => "+1 650 253 0000";
    protected override string DefaultRegion => "US";

    // Only the rendered formats depend on this; the parsed number does not, so no re-parse.
    private void OnCallingFromChange(string region) => _callingFrom = region;
}
