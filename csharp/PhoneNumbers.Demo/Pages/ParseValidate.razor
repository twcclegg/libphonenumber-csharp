@page "/parse"
@inherits PhoneNumberPageBase

<PageTitle>Parse &amp; Validate - libphonenumber-csharp</PageTitle>

<div class="reveal">
<div class="page-header">
    <div class="page-header__eyebrow">PhoneNumberUtil.Parse</div>
    <h1 class="page-header__title">Parse &amp; Validate</h1>
    <p class="page-header__description">Parse any phone number string, validate it against regional rules, and inspect all of its properties.</p>
</div>

<div class="card">
    <div class="card__header">
        <div class="card__title">Input</div>
    </div>

    <div class="form__row">
        <div class="form__group form__group--flush">
            <label class="form__label" for="parse-phone">Phone Number</label>
            <input id="parse-phone"
                   class="form__input form__input--phone"
                   type="text"
                   value="@PhoneInput"
                   @oninput="OnPhoneInput"
                   @onchange="OnPhoneCommit"
                   placeholder="+44 20 7946 0958"
                   autocomplete="tel" />
        </div>
        <div class="form__group form__group--flush">
            <label class="form__label" for="parse-region">Default Region</label>
            <RegionSelect id="parse-region" Value="@SelectedRegion" ValueChanged="OnRegionChange" />
        </div>
    </div>

    <div class="flex gap-1 flex-wrap mt-2">
        <button class="btn btn--sm btn--chip" @onclick='() => SetExample("+1 650 253 0000", "US")'>US Example</button>
        <button class="btn btn--sm btn--chip" @onclick='() => SetExample("+44 20 7946 0958", "GB")'>UK Example</button>
        <button class="btn btn--sm btn--chip" @onclick='() => SetExample("+49 30 123456", "DE")'>DE Example</button>
        <button class="btn btn--sm btn--chip" @onclick='() => SetExample("+61 2 3661 8300", "AU")'>AU Example</button>
        <button class="btn btn--sm btn--chip" @onclick='() => SetExample("+81 3 6384 9000", "JP")'>JP Example</button>
        <button class="btn btn--sm btn--chip" @onclick='() => SetExample("0412 345 678", "AU")'>Local AU</button>
    </div>
</div>

@if (ParseError != null)
{
    <div class="error-message" role="alert">@ParseError</div>
}
else if (Parsed != null)
{
    <div aria-live="polite">
        <div class="card">
            <div class="card__header">
                <div class="card__title">Validation</div>
            </div>

            <div class="result-grid">
                <div class="result-grid__item">
                    <div class="result-grid__label">Is Valid</div>
                    <div class="result-grid__value">
                        @if (_isValid)
                        {
                            <span class="badge badge--success">Valid</span>
                        }
                        else
                        {
                            <span class="badge badge--error">Invalid</span>
                        }
                    </div>
                </div>
                <div class="result-grid__item">
                    <div class="result-grid__label">Is Possible</div>
                    <div class="result-grid__value">
                        @if (_isPossible)
                        {
                            <span class="badge badge--success">Possible</span>
                        }
                        else
                        {
                            <span class="badge badge--warning">Not Possible</span>
                        }
                    </div>
                </div>
                <div class="result-grid__item">
                    <div class="result-grid__label">Possible Reason</div>
                    <div class="result-grid__value"><span class="badge badge--neutral">@_possibleReason</span></div>
                </div>
                <div class="result-grid__item">
                    <div class="result-grid__label">Number Type</div>
                    <div class="result-grid__value"><span class="badge badge--info">@NumberTypeLabels.For(_numberType)</span></div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card__header">
                <div class="card__title">Parsed Properties</div>
            </div>

            <div class="data-table__row">
                <div class="data-table__key">Country Code</div>
                <div class="data-table__value data-table__value--mono">+@Parsed.CountryCode</div>
            </div>
            <div class="data-table__row">
                <div class="data-table__key">National Number</div>
                <div class="data-table__value data-table__value--mono">@Parsed.NationalNumber</div>
            </div>
            @if (Parsed.HasExtension)
            {
                <div class="data-table__row">
                    <div class="data-table__key">Extension</div>
                    <div class="data-table__value data-table__value--mono">@Parsed.Extension</div>
                </div>
            }
            <div class="data-table__row">
                <div class="data-table__key">Region</div>
                <div class="data-table__value">@(_regionCode ?? "Unknown")</div>
            </div>
            <div class="data-table__row">
                <div class="data-table__key">Is Geographical</div>
                <div class="data-table__value">@(PhoneUtil.IsNumberGeographical(Parsed) ? "Yes" : "No")</div>
            </div>
            <div class="data-table__row">
                <div class="data-table__key">Leading Zeros</div>
                <div class="data-table__value">@(Parsed.HasNumberOfLeadingZeros ? Parsed.NumberOfLeadingZeros.ToString() : "0")</div>
            </div>

            @if (_isValid && _regionCode != null)
            {
                <div class="data-table__row">
                    <div class="data-table__key">Area Code Length</div>
                    <div class="data-table__value">@PhoneUtil.GetLengthOfGeographicalAreaCode(Parsed)</div>
                </div>
                <div class="data-table__row">
                    <div class="data-table__key">National Dest. Code Length</div>
                    <div class="data-table__value">@PhoneUtil.GetLengthOfNationalDestinationCode(Parsed)</div>
                </div>
            }
        </div>

        @if (_regionCode != null)
        {
            <div class="card">
                <div class="card__header">
                    <div class="card__title">Region Info: @_regionCode</div>
                </div>

                <div class="data-table__row">
                    <div class="data-table__key">Country Calling Code</div>
                    <div class="data-table__value data-table__value--mono">+@PhoneUtil.GetCountryCodeForRegion(_regionCode)</div>
                </div>
                <div class="data-table__row">
                    <div class="data-table__key">NANPA Country</div>
                    <div class="data-table__value">@(PhoneUtil.IsNANPACountry(_regionCode) ? "Yes" : "No")</div>
                </div>
                <div class="data-table__row">
                    <div class="data-table__key">Mobile Portable</div>
                    <div class="data-table__value">@(PhoneUtil.IsMobileNumberPortableRegion(_regionCode) ? "Yes" : "No")</div>
                </div>

                @if (_exampleNumber != null)
                {
                    <div class="data-table__row">
                        <div class="data-table__key">Example Number</div>
                        <div class="data-table__value data-table__value--mono">@PhoneUtil.Format(_exampleNumber, PhoneNumberFormat.INTERNATIONAL)</div>
                    </div>
                }

                @if (_exampleMobile != null)
                {
                    <div class="data-table__row">
                        <div class="data-table__key">Example Mobile</div>
                        <div class="data-table__value data-table__value--mono">@PhoneUtil.Format(_exampleMobile, PhoneNumberFormat.INTERNATIONAL)</div>
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-state__icon" aria-hidden="true">
                <SearchIcon />
            </div>
            <p class="empty-state__message">Enter a phone number above to see parsed results</p>
        </div>
    </div>
}
</div>

@code {
    private bool _isValid;
    private bool _isPossible;
    private PhoneNumberUtil.ValidationResult _possibleReason;
    private PhoneNumberType _numberType;
    private string? _regionCode;
    private PhoneNumber? _exampleNumber;
    private PhoneNumber? _exampleMobile;

    protected override string DefaultNumber => "+44 20 7946 0958";
    protected override string DefaultRegion => "GB";

    protected override void OnParsed(PhoneNumber? number)
    {
        // Clear every derived field, not just some, so nothing outlives the number it came from.
        _isValid = false;
        _isPossible = false;
        _possibleReason = default;
        _numberType = PhoneNumberType.UNKNOWN;
        _regionCode = null;
        _exampleNumber = null;
        _exampleMobile = null;
        if (number == null) return;

        _isValid = PhoneUtil.IsValidNumber(number);
        _isPossible = PhoneUtil.IsPossibleNumber(number);
        _possibleReason = PhoneUtil.IsPossibleNumberWithReason(number);
        _numberType = PhoneUtil.GetNumberType(number);
        _regionCode = PhoneUtil.GetRegionCodeForNumber(number);

        if (_regionCode != null)
        {
            _exampleNumber = PhoneUtil.GetExampleNumber(_regionCode);
            _exampleMobile = PhoneUtil.GetExampleNumberForType(_regionCode, PhoneNumberType.MOBILE);
        }
    }
}
