@page "/geo"
@inherits PhoneNumberPageBase

<PageTitle>Geocoding &amp; Timezone | libphonenumber-csharp</PageTitle>

<div class="reveal">
<div class="page-header">
    <ApiReferenceLink Api="PhoneNumberOfflineGeocoder" Path="@DocsLinks.OfflineGeocoder" />
    <h1 class="page-header__title">Geocoding &amp; Timezone</h1>
    <p class="page-header__description">Look up the geographic description, time zone, and carrier information associated with a phone number.</p>
</div>

<div class="card">
    <div class="card__header">
        <div class="card__title">Input</div>
    </div>

    <div class="form__row--three-col">
        <div class="form__group form__group--flush">
            <label class="form__label" for="geo-phone">Phone Number</label>
            <input id="geo-phone"
                   class="form__input form__input--phone"
                   type="text"
                   value="@PhoneInput"
                   @oninput="OnPhoneInput"
                   @onchange="OnPhoneCommit"
                   placeholder="+1 650 253 0000"
                   autocomplete="tel" />
        </div>
        <div class="form__group form__group--flush">
            <label class="form__label" for="geo-region">Default Region</label>
            <RegionSelect id="geo-region" Value="@SelectedRegion" ValueChanged="OnRegionChange" />
        </div>
        <div class="form__group form__group--flush">
            <label class="form__label" for="geo-locale">Language</label>
            <select id="geo-locale" class="form__select" @onchange="OnLocaleChange">
                @foreach (var l in Languages)
                {
                    <option value="@l.Code" selected="@(l == _language)">@l.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="flex gap-1 flex-wrap mt-2">
        <button class="btn btn--sm btn--chip" @onclick='() => SetExample("+1 650 253 0000", "US")'>US (Mountain View)</button>
        <button class="btn btn--sm btn--chip" @onclick='() => SetExample("+44 20 7946 0958", "GB")'>UK (London)</button>
        <button class="btn btn--sm btn--chip" @onclick='() => SetExample("+49 30 123456", "DE")'>DE (Berlin)</button>
        <button class="btn btn--sm btn--chip" @onclick='() => SetExample("+81 3 6384 9000", "JP")'>JP (Tokyo)</button>
        <button class="btn btn--sm btn--chip" @onclick='() => SetExample("+33 1 42 68 53 00", "FR")'>FR (Paris)</button>
    </div>
</div>

@if (_isLoading)
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-state__icon" aria-hidden="true">
                <GlobeIcon />
            </div>
            <p class="empty-state__message">Loading geocoding data&hellip;</p>
        </div>
    </div>
}
else if (ParseError != null)
{
    <div class="error-message" role="alert">@ParseError</div>
}
else if (Parsed != null)
{
    <div aria-live="polite">
        <div class="card">
            <div class="card__header">
                <div class="card__title">Geographic Location</div>
            </div>

            <div class="result-grid">
                <div class="result-grid__item result-grid__item--full">
                    <div class="result-grid__label">Description</div>
                    <div class="result-grid__value result-grid__value--lg">
                        @if (!string.IsNullOrEmpty(_geoDescription))
                        {
                            @_geoDescription
                        }
                        else
                        {
                            <span class="text-secondary">No geographic data available</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card__header">
                <div class="card__title">Time Zones</div>
            </div>

            @if (_timeZones.Count > 0)
            {
                <div class="flex gap-sm flex-wrap">
                    @foreach (var tz in _timeZones)
                    {
                        <span class="badge badge--accent">@tz</span>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-secondary">No timezone data available for this number</p>
            }
        </div>

        <div class="card">
            <div class="card__header">
                <div class="card__title">Carrier</div>
            </div>

            <div class="result-grid">
                <div class="result-grid__item result-grid__item--full">
                    <div class="result-grid__label">Carrier Name</div>
                    <div class="result-grid__value">
                        @if (!string.IsNullOrEmpty(_carrierName))
                        {
                            @_carrierName
                        }
                        else
                        {
                            <span class="text-secondary">No carrier data available</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card__header">
                <div class="card__title">Number Details</div>
            </div>

            <div class="data-table__row">
                <div class="data-table__key">Formatted</div>
                <div class="data-table__value data-table__value--mono">@PhoneUtil.Format(Parsed, PhoneNumberFormat.INTERNATIONAL)</div>
            </div>
            <div class="data-table__row">
                <div class="data-table__key">Valid</div>
                <div class="data-table__value">
                    @if (PhoneUtil.IsValidNumber(Parsed))
                    {
                        <span class="badge badge--success">Valid</span>
                    }
                    else
                    {
                        <span class="badge badge--error">Invalid</span>
                    }
                </div>
            </div>
            <div class="data-table__row">
                <div class="data-table__key">Number Type</div>
                <div class="data-table__value"><span class="badge badge--info">@NumberTypeLabels.For(PhoneUtil.GetNumberType(Parsed))</span></div>
            </div>
            <div class="data-table__row">
                <div class="data-table__key">Is Geographical</div>
                <div class="data-table__value">@(PhoneUtil.IsNumberGeographical(Parsed) ? "Yes" : "No")</div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-state__icon" aria-hidden="true">
                <GlobeIcon />
            </div>
            <p class="empty-state__message">Enter a phone number above to see geographic and timezone data</p>
        </div>
    </div>
}
</div>

@code {
    private PhoneNumberOfflineGeocoder? _geocoder;
    private PhoneNumberToTimeZonesMapper? _tzMapper;
    private PhoneNumberToCarrierMapper? _carrierMapper;

    private string _geoDescription = "";
    private List<string> _timeZones = new();
    private string _carrierName = "";
    private bool _isLoading = true;

    // The languages the geocoding and carrier data are offered in: the option value, its label and
    // the Locale passed to the lookups, in one row so the three can't drift apart.
    private static readonly IReadOnlyList<Language> Languages =
    [
        new("en", "English", Locale.English),
        new("de", "German", Locale.German),
        new("fr", "French", Locale.French),
        new("it", "Italian", Locale.Italian),
        new("ko", "Korean", Locale.Korean),
        new("zh", "Chinese (Simplified)", Locale.SimplifiedChinese),
    ];

    private Language _language = Languages[0];

    protected override string DefaultNumber => "+1 650 253 0000";
    protected override string DefaultRegion => "US";

    protected override async Task OnInitializedAsync()
    {
        // Yield so the loading state renders before we block the thread loading
        // the large geocoding/timezone/carrier embedded binary datasets.
        await Task.Yield();

        _geocoder = PhoneNumberOfflineGeocoder.GetInstance();
        _tzMapper = PhoneNumberToTimeZonesMapper.GetInstance();
        _carrierMapper = PhoneNumberToCarrierMapper.GetInstance();

        _isLoading = false;
        TryParse();
    }

    private void OnLocaleChange(ChangeEventArgs e)
    {
        _language = Languages.FirstOrDefault(l => l.Code == e.Value?.ToString()) ?? Languages[0];
        TryParse();
    }

    protected override void OnParsed(PhoneNumber? number)
    {
        _geoDescription = "";
        _timeZones.Clear();
        _carrierName = "";
        if (number == null) return;

        var locale = _language.Locale;
        _geoDescription = _geocoder?.GetDescriptionForNumber(number, locale) ?? "";
        // The mapper reports "no data" as a lone Etc/Unknown zone, never as an empty list.
        var unknownZone = _tzMapper?.GetUnknownTimeZone();
        _timeZones = _tzMapper?.GetTimeZonesForNumber(number).Where(tz => tz != unknownZone).ToList()
                     ?? new List<string>();
        _carrierName = _carrierMapper?.GetNameForNumber(number, locale) ?? "";
    }

    private record Language(string Code, string Name, Locale Locale);
}
