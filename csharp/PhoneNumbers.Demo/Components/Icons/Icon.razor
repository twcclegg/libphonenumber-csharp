@* Shared <svg> wrapper used by every icon component in this folder. Not used directly by pages. *@
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" @attributes="AdditionalAttributes">@ChildContent</svg>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
