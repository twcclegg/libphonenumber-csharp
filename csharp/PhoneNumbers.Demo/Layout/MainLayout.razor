@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject TimeProvider Time

<div class="app-layout">
    @if (_sidebarOpen)
    {
        <div class="sidebar__overlay sidebar__overlay--visible" @onclick="CloseSidebar"></div>
    }

    <nav class="sidebar @(_sidebarOpen ? "sidebar--open" : "")" aria-label="Main navigation">
        <div class="sidebar__header">
            <a href="" class="sidebar__logo">
                <div class="sidebar__logo-icon" aria-hidden="true">
                    <PhoneIcon />
                </div>
                <div>
                    <div class="sidebar__title">libphonenumber</div>
                    <div class="sidebar__subtitle">C# · WebAssembly</div>
                </div>
            </a>
            <div class="sidebar__top-actions">
                @ChromeActions("rail-icon-btn")
            </div>
        </div>

        <div class="sidebar__nav">
            @foreach (var navSection in Enum.GetValues<NavSection>())
            {
                <div class="sidebar__section">
                    <div class="sidebar__section-title">@navSection</div>
                    @foreach (var link in Pages.Where(p => p.Section == navSection))
                    {
                        <NavLink href="@link.Href" class="sidebar__link" ActiveClass="sidebar__link--active"
                                 Match="@(link.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" @onclick="CloseSidebar">
                            <span class="sidebar__link-icon" aria-hidden="true">
                                @link.Icon
                            </span>
                            @link.Title
                        </NavLink>
                    }
                </div>
            }

            <div class="sidebar__section">
                <div class="sidebar__section-title">Resources</div>
                <a href="@DocsUrl" class="sidebar__link">
                    <span class="sidebar__link-icon" aria-hidden="true">
                        <BookIcon />
                    </span>
                    API Docs
                </a>
                <a href="https://github.com/twcclegg/libphonenumber-csharp" target="_blank" rel="noopener" class="sidebar__link">
                    <span class="sidebar__link-icon" aria-hidden="true">
                        <GitHubIcon />
                    </span>
                    GitHub
                </a>
                <a href="https://www.nuget.org/packages/libphonenumber-csharp" target="_blank" rel="noopener" class="sidebar__link">
                    <span class="sidebar__link-icon" aria-hidden="true">
                        <NuGetIcon />
                    </span>
                    NuGet
                </a>
            </div>
        </div>

        <div class="sidebar__footer">
            <span class="wasm-pill">
                <span class="wasm-dot" aria-hidden="true"></span>
                Running in your browser
            </span>
        </div>
    </nav>

    <main class="app-layout__content">
        <div class="topbar">
            <button class="icon-btn" @onclick="OpenSidebar" aria-label="Open navigation" aria-expanded="@_sidebarOpen">
                <MenuIcon />
            </button>
            <span class="topbar__title">@_currentTitle</span>
            <span class="topbar__spacer"></span>
            <div class="topbar__actions">
                @ChromeActions("icon-btn")
            </div>
        </div>

        <div class="app-layout__container">
            @Body
        </div>
    </main>
</div>

@code {
    private bool _sidebarOpen;
    private string _theme = "light";
    private bool _shareCopied;
    private int _shareClicks;
    private static readonly TimeSpan ConfirmationTime = TimeSpan.FromMilliseconds(1500);
    private string _currentTitle = "Home";

    // The API docs site is published as a sibling folder alongside this app (see
    // deploy-demo.yml, which copies docfx's output to release/wwwroot/docs). Nav.BaseUri
    // already includes the GitHub Pages repo-name PathBase, so this resolves correctly
    // regardless of which client-side route the user is currently on.
    private string DocsUrl => $"{Nav.BaseUri}docs/";

    // Every page the sidebar links to, in order: its route, the title the sidebar and the mobile
    // topbar show for it, its icon and the sidebar section it sits under.
    private static readonly IReadOnlyList<PageLink> Pages =
    [
        new("", "Home", Icon<HomeIcon>(), NavSection.Overview),
        new("parse", "Parse & Validate", Icon<SearchIcon>(), NavSection.Features),
        new("format", "Formatting", Icon<ListIcon>(), NavSection.Features),
        new("live", "Live Formatter", Icon<TerminalIcon>(), NavSection.Features),
        new("find", "Find Numbers", Icon<FileTextIcon>(), NavSection.Features),
        new("geo", "Geo & Timezone", Icon<GlobeIcon>(), NavSection.Features),
    ];

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateTitle();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _theme = await JS.InvokeAsync<string>("phoneDemo.getTheme");
                StateHasChanged();
            }
            catch (JSException)
            {
                // Prerender / non-browser host — keep the default theme.
            }
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateTitle();
        _sidebarOpen = false;
        StateHasChanged();
    }

    private void UpdateTitle()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var q = path.IndexOf('?');
        if (q >= 0) path = path[..q];
        path = path.Trim('/');
        _currentTitle = Pages.FirstOrDefault(p => p.Href == path)?.Title ?? "Home";
    }

    private void OpenSidebar() => _sidebarOpen = true;
    private void CloseSidebar() => _sidebarOpen = false;

    private async Task ToggleTheme()
    {
        _theme = await JS.InvokeAsync<string>("phoneDemo.toggleTheme");
    }

    private async Task CopyLink()
    {
        // Take the token before awaiting, so it matches the order of the clicks themselves.
        var click = ++_shareClicks;
        await JS.InvokeVoidAsync("phoneDemo.copyText", Nav.Uri);
        _shareCopied = true;
        StateHasChanged();
        await Task.Delay(ConfirmationTime, Time);
        // A later click restarted the confirmation; its own timer clears it.
        if (click != _shareClicks) return;
        _shareCopied = false;
        StateHasChanged();
    }

    // sun when in dark mode (to switch to light), moon otherwise
    private RenderFragment ThemeIcon() => _theme == "dark" ? @<SunIcon /> : @<MoonIcon />;

    // Each button's tooltip is its accessible name, so the two never disagree.
    private string ShareLabel => _shareCopied ? "Link copied" : "Copy shareable link";
    private string ThemeLabel => _theme == "dark" ? "Switch to light mode" : "Switch to dark mode";

    // The share and theme buttons, rendered in both the sidebar header and the mobile topbar;
    // only the button block differs between the two.
    private RenderFragment ChromeActions(string block) =>
        @<text>
            <button class="@block @(_shareCopied ? block + "--done" : "")"
                    @onclick="CopyLink"
                    aria-label="@ShareLabel"
                    title="@ShareLabel">
                @if (_shareCopied)
                {
                    <CheckIcon />
                }
                else
                {
                    <ShareIcon />
                }
            </button>
            <button class="@block"
                    @onclick="ToggleTheme"
                    aria-label="@ThemeLabel"
                    title="@ThemeLabel">
                @ThemeIcon()
            </button>
        </text>;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private static RenderFragment Icon<TIcon>() where TIcon : IconBase => builder =>
    {
        builder.OpenComponent<TIcon>(0);
        builder.CloseComponent();
    };

    // Sidebar sections render in declaration order, whatever order the Pages table lists them in.
    private enum NavSection { Overview, Features }

    private record PageLink(string Href, string Title, RenderFragment Icon, NavSection Section);
}
