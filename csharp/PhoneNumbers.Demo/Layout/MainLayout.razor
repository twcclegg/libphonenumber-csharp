@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="app-layout">
    @if (_sidebarOpen)
    {
        <div class="sidebar__overlay sidebar__overlay--visible" @onclick="CloseSidebar"></div>
    }

    <nav class="sidebar @(_sidebarOpen ? "sidebar--open" : "")" aria-label="Main navigation">
        <div class="sidebar__header">
            <a href="" class="sidebar__logo">
                <div class="sidebar__logo-icon" aria-hidden="true">
                    <PhoneIcon />
                </div>
                <div>
                    <div class="sidebar__title">libphonenumber</div>
                    <div class="sidebar__subtitle">C# · WebAssembly</div>
                </div>
            </a>
            <div class="sidebar__top-actions">
                <button class="rail-icon-btn @(_shareCopied ? "rail-icon-btn--done" : "")"
                        @onclick="CopyLink"
                        aria-label="@(_shareCopied ? "Link copied" : "Copy shareable link")"
                        title="Copy shareable link">
                    @if (_shareCopied)
                    {
                        <CheckIcon />
                    }
                    else
                    {
                        <ShareIcon />
                    }
                </button>
                <button class="rail-icon-btn"
                        @onclick="ToggleTheme"
                        aria-label="@(_theme == "dark" ? "Switch to light mode" : "Switch to dark mode")"
                        title="Toggle theme">
                    @ThemeIcon()
                </button>
            </div>
        </div>

        <div class="sidebar__nav">
            <div class="sidebar__section">
                <div class="sidebar__section-title">Overview</div>
                <NavLink href="" class="sidebar__link" ActiveClass="sidebar__link--active" Match="NavLinkMatch.All" @onclick="CloseSidebar">
                    <span class="sidebar__link-icon" aria-hidden="true">
                        <HomeIcon />
                    </span>
                    Home
                </NavLink>
            </div>

            <div class="sidebar__section">
                <div class="sidebar__section-title">Features</div>
                <NavLink href="parse" class="sidebar__link" ActiveClass="sidebar__link--active" @onclick="CloseSidebar">
                    <span class="sidebar__link-icon" aria-hidden="true">
                        <SearchIcon />
                    </span>
                    Parse &amp; Validate
                </NavLink>
                <NavLink href="format" class="sidebar__link" ActiveClass="sidebar__link--active" @onclick="CloseSidebar">
                    <span class="sidebar__link-icon" aria-hidden="true">
                        <ListIcon />
                    </span>
                    Formatting
                </NavLink>
                <NavLink href="live" class="sidebar__link" ActiveClass="sidebar__link--active" @onclick="CloseSidebar">
                    <span class="sidebar__link-icon" aria-hidden="true">
                        <TerminalIcon />
                    </span>
                    Live Formatter
                </NavLink>
                <NavLink href="find" class="sidebar__link" ActiveClass="sidebar__link--active" @onclick="CloseSidebar">
                    <span class="sidebar__link-icon" aria-hidden="true">
                        <FileTextIcon />
                    </span>
                    Find Numbers
                </NavLink>
                <NavLink href="geo" class="sidebar__link" ActiveClass="sidebar__link--active" @onclick="CloseSidebar">
                    <span class="sidebar__link-icon" aria-hidden="true">
                        <GlobeIcon />
                    </span>
                    Geo &amp; Timezone
                </NavLink>
            </div>

            <div class="sidebar__section">
                <div class="sidebar__section-title">Resources</div>
                <a href="@DocsUrl" class="sidebar__link">
                    <span class="sidebar__link-icon" aria-hidden="true">
                        <BookIcon />
                    </span>
                    API Docs
                </a>
                <a href="https://github.com/twcclegg/libphonenumber-csharp" target="_blank" rel="noopener" class="sidebar__link">
                    <span class="sidebar__link-icon" aria-hidden="true">
                        <GitHubIcon />
                    </span>
                    GitHub
                </a>
                <a href="https://www.nuget.org/packages/libphonenumber-csharp" target="_blank" rel="noopener" class="sidebar__link">
                    <span class="sidebar__link-icon" aria-hidden="true">
                        <NuGetIcon />
                    </span>
                    NuGet
                </a>
            </div>
        </div>

        <div class="sidebar__footer">
            <span class="wasm-pill">
                <span class="wasm-dot" aria-hidden="true"></span>
                Running in your browser
            </span>
        </div>
    </nav>

    <main class="app-layout__content">
        <div class="topbar">
            <button class="icon-btn" @onclick="OpenSidebar" aria-label="Open navigation" aria-expanded="@_sidebarOpen">
                <MenuIcon />
            </button>
            <span class="topbar__title">@_currentTitle</span>
            <span class="topbar__spacer"></span>
            <div class="topbar__actions">
                <button class="icon-btn @(_shareCopied ? "icon-btn--done" : "")"
                        @onclick="CopyLink"
                        aria-label="@(_shareCopied ? "Link copied" : "Copy shareable link")">
                    @if (_shareCopied)
                    {
                        <CheckIcon />
                    }
                    else
                    {
                        <ShareIcon />
                    }
                </button>
                <button class="icon-btn" @onclick="ToggleTheme"
                        aria-label="@(_theme == "dark" ? "Switch to light mode" : "Switch to dark mode")">
                    @ThemeIcon()
                </button>
            </div>
        </div>

        <div class="app-layout__container">
            @Body
        </div>
    </main>
</div>

@code {
    private bool _sidebarOpen;
    private string _theme = "light";
    private bool _shareCopied;
    private int _shareClicks;
    private string _currentTitle = "Home";

    // The API docs site is published as a sibling folder alongside this app (see
    // deploy-demo.yml, which copies docfx's output to release/wwwroot/docs). Nav.BaseUri
    // already includes the GitHub Pages repo-name PathBase, so this resolves correctly
    // regardless of which client-side route the user is currently on.
    private string DocsUrl => $"{Nav.BaseUri}docs/";

    private static readonly Dictionary<string, string> Titles = new()
    {
        [""] = "Home",
        ["parse"] = "Parse & Validate",
        ["format"] = "Formatting",
        ["live"] = "Live Formatter",
        ["find"] = "Find Numbers",
        ["geo"] = "Geo & Timezone",
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateTitle();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _theme = await JS.InvokeAsync<string>("phoneDemo.getTheme");
                StateHasChanged();
            }
            catch (JSException)
            {
                // Prerender / non-browser host — keep the default theme.
            }
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateTitle();
        _sidebarOpen = false;
        StateHasChanged();
    }

    private void UpdateTitle()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var q = path.IndexOf('?');
        if (q >= 0) path = path[..q];
        path = path.Trim('/');
        _currentTitle = Titles.TryGetValue(path, out var title) ? title : "Home";
    }

    private void OpenSidebar() => _sidebarOpen = true;
    private void CloseSidebar() => _sidebarOpen = false;

    private async Task ToggleTheme()
    {
        _theme = await JS.InvokeAsync<string>("phoneDemo.toggleTheme");
    }

    private async Task CopyLink()
    {
        await JS.InvokeVoidAsync("phoneDemo.copyText", Nav.Uri);
        var click = ++_shareClicks;
        _shareCopied = true;
        StateHasChanged();
        await Task.Delay(1500);
        // A later click restarted the confirmation; its own timer clears it.
        if (click != _shareClicks) return;
        _shareCopied = false;
        StateHasChanged();
    }

    // sun when in dark mode (to switch to light), moon otherwise
    private RenderFragment ThemeIcon() => _theme == "dark" ? @<SunIcon /> : @<MoonIcon />;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
