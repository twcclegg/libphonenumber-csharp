<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>PhoneNumbers.Test</AssemblyName>
    <PackageId>PhoneNumbers.Test</PackageId>
    <NoWarn>$(NoWarn);CA1014</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Single ProjectReference to PhoneNumbers (which itself references MetadataBuilder). Don't
      add a direct ProjectReference to MetadataBuilder here: at sln level it would cause MSBuild
      to spawn two parallel builds of MetadataBuilder (one per parent), racing on apphost
      generation under obj/Debug/net10.0/. The transitive dep through PhoneNumbers gives us the
      ordering we need without the parallelism.
    -->
    <ProjectReference Include="..\PhoneNumbers\PhoneNumbers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Property-based tests: see TestPhoneNumberProperties. FsCheck is referenced directly as
         well as through FsCheck.Xunit because the generators are used explicitly. -->
    <PackageReference Include="FsCheck" />
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      The test project embeds the XML metadata files used by tests that exercise
      BuildMetadataFromXml directly (e.g. TestBuildMetadataFromBin, TestBuildMetadataFromXml).
      The production library no longer ships XML; tests pass typeof(TestX).Assembly so the
      resource resolver picks them up here instead.
    -->
    <EmbeddedResource Include="..\..\resources\PhoneNumberMetadata.xml" />
    <EmbeddedResource Include="..\..\resources\ShortNumberMetadata.xml" />
    <EmbeddedResource Include="..\..\resources\PhoneNumberAlternateFormats.xml" />
    <EmbeddedResource Include="..\..\resources\PhoneNumberMetadataForTesting.xml" />
    <!--
      The consumer-facing half of the trimming feature. Embedded so TestTrimmedDataDiagnostics can
      assert it agrees with the ILLink.Substitutions.xml inside PhoneNumbers.dll: the switch names
      live in those two files and nothing else connects them, so a typo in either silently disables
      the opt-out with no warning and no failing test.
    -->
    <EmbeddedResource Include="..\PhoneNumbers\buildTransitive\libphonenumber-csharp.targets"
                      LogicalName="PhoneNumbers.Test.buildTransitive.targets" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      No trailing separator (Windows shell would corrupt the path inside the Exec command — see
      the matching note in PhoneNumbers.csproj).
    -->
    <BinaryTestGeocodingDir>$(BaseIntermediateOutputPath)test-geocoding</BinaryTestGeocodingDir>
    <BinaryTestCarrierDir>$(BaseIntermediateOutputPath)test-carrier</BinaryTestCarrierDir>
    <TestResourcesGeocodingDir>$(MSBuildThisFileDirectory)..\..\resources/test/geocoding</TestResourcesGeocodingDir>
    <TestResourcesCarrierDir>$(MSBuildThisFileDirectory)..\..\resources/test/carrier</TestResourcesCarrierDir>
    <MetadataBuilderDll>$(MSBuildThisFileDirectory)..\PhoneNumbers.MetadataBuilder\bin\$(Configuration)\net10.0\PhoneNumbers.MetadataBuilder.dll</MetadataBuilderDll>
  </PropertyGroup>

  <!-- MetadataBuilder is built transitively via PhoneNumbers' ProjectReference, and invoked as
       a dll rather than via `dotnet run` — see the matching note in PhoneNumbers.csproj. -->

  <!--
    Top-level ItemGroup so the wildcard is resolved at MSBuild parse time — see matching note in
    PhoneNumbers.csproj for why we don't collect this inside the target body.
  -->
  <ItemGroup>
    <_TestGeocodingTextFile Include="$(TestResourcesGeocodingDir)/**/*.txt" />
  </ItemGroup>

  <ItemGroup>
    <_TestCarrierTextFile Include="$(TestResourcesCarrierDir)/**/*.txt" />
  </ItemGroup>

  <!--
    Same shape as PhoneNumbers.csproj: the target hooks AssignTargetPaths, so it runs per inner
    per-TFM build and the Inputs/Outputs gate is what makes the later ones see fresh outputs and
    skip. That is what keeps concurrent inner builds from both writing obj/test-geocoding.
  -->
  <ItemGroup>
    <_GeneratedTestDataOutput Include="$(BinaryTestGeocodingDir)/geocoding.pack" />
    <_GeneratedTestDataOutput Include="$(BinaryTestCarrierDir)/carrier.pack" />
  </ItemGroup>

  <Target Name="GenerateTestGeocodingBins"
          BeforeTargets="AssignTargetPaths"
          Inputs="@(_TestGeocodingTextFile);@(_TestCarrierTextFile)"
          Outputs="@(_GeneratedTestDataOutput)">
    <Exec Command="dotnet &quot;$(MetadataBuilderDll)&quot; geocoding &quot;$(TestResourcesGeocodingDir)&quot; &quot;$(BinaryTestGeocodingDir)/geocoding.pack&quot;" />
    <Exec Command="dotnet &quot;$(MetadataBuilderDll)&quot; carrier &quot;$(TestResourcesCarrierDir)&quot; &quot;$(BinaryTestCarrierDir)/carrier.pack&quot;" />
    <!-- Both packs share one gate but refresh independently; see the matching note in
         PhoneNumbers.csproj for why the untouched one has to be touched anyway. -->
    <Touch Files="@(_GeneratedTestDataOutput)" />
  </Target>

  <!--
    The fixture data is packed exactly like the shipped data, so PrefixFileReader takes the same
    path here as in production - the alternative would leave the pack reader untested by every
    geocoder and carrier test in the suite.
  -->
  <Target Name="EmbedTestGeocoding"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="GenerateTestGeocodingBins">
    <ItemGroup>
      <EmbeddedResource Include="$(BinaryTestGeocodingDir)/geocoding.pack"
                        LogicalName="PhoneNumbers.Test.geocoding.pack" />
      <EmbeddedResource Include="$(BinaryTestCarrierDir)/carrier.pack"
                        LogicalName="PhoneNumbers.Test.carrier.pack" />
    </ItemGroup>
  </Target>

  <!-- Outer build only; see the matching note on CleanBinaryMetadata in PhoneNumbers.csproj. -->
  <Target Name="CleanTestGeocoding" AfterTargets="Clean"
          Condition="'$(TargetFramework)' == '' Or '$(TargetFrameworks)' == ''">
    <RemoveDir Directories="$(BinaryTestGeocodingDir)" Condition="Exists('$(BinaryTestGeocodingDir)')" />
    <RemoveDir Directories="$(BinaryTestCarrierDir)" Condition="Exists('$(BinaryTestCarrierDir)')" />
  </Target>

  <ItemGroup>
    <Service Include="{82a7f48d-3b50-4b1e-b82e-3ada8210c358}" />
  </ItemGroup>

</Project>
